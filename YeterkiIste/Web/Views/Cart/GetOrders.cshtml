
@model List<Web.ViewModels.OrderListVM>

<div class="sign-detail"></div>
<section class="order_details section-margin--small">
    <div class="container">
        <div class="row mb-5">
            <h2>Sipariş Sayfası</h2>

<div class="table-responsive">

@if (Model.Count > 0)
{
    @foreach (var item in Model)
    {

<table class="table table-bordered table-sm mb-5">
    <thead class="bg-primary text-white">
        <tr>
            <th colspan="2">Sipariş Numarası: #@item.OrderId    </th>
            <th>Miktar</th>
            <th>Fiyat</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item2 in item.OrderItemVM)
        {
            <tr>
                <td> <img src="@item2.ImageUrl" width="60" alt="" /> </td>
                <td>@item2.Name</td>
                <td>@item2.Quantity</td>
                <td>@item2.Price</td>
            </tr>
        }
    </tbody>

    <tfoot style="background:#f1f1f1">
        <tr class="mb-3">
            <th colspan="3">Toplam:</th>
            <th>@item.TotalPrice()</th>
        </tr>
        <tr>
            <td>Alıcı Adı:</td>
            <td colspan="3">@item.FirstName @item.LastName</td>
        </tr>


        <tr>
            <td>Adres: </td>
            <td colspan="3">@item.Address</td>
        </tr>
        <tr>
            <td>Email:</td>
            <td>@item.Email</td>
            <td>Telefon Numarası:</td>
            <td>@item.Phone</td>
        </tr>
        <tr>
            <td>Ödeme Durumu:</td>
            <td>@item.PaymentTypes</td>
            <td>Sipariş Durumu: </td>
            <th>@item.OrderState</th>
        </tr>
    </tfoot>
</table>
    }
}
else
{
 <p>Henüz bir siparişiniz mevcut değil.</p>
}


</div>
</div></div></section>