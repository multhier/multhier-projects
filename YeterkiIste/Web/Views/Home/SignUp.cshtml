@model Web.ViewModels.UserVM


<script src="/js/jquery-3.2.1.min.js"></script>
<script src="/lib/jquery-validate/jquery.validate.min.js"></script>
<script src="/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>







<!--================Login Box Area =================-->
<section class="login_box_area  pt-2 pb-2 ">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="login_box_img">
                    <div class="hover">
                        <h4>Sitemize üye misiniz?</h4>
                        <p>O zaman sizi Login sayfasına yönlendirelim. Butonu tıklayarak ilgili sayfaya ulaşabilirsiniz.</p>
                        <a class="button button-account" href="/Home/SignIn">Login </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="login_form_inner register_form_inner">
                    <h3>Hesap Oluştur</h3>
                    <form class="row login_form" asp-action="SignUp">
                        <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                        <div class="col-md-12 form-group">

                            <input type="text" class="form-control" asp-for="UserName" placeholder="Kullanıcı Adı" onfocus="this.placeholder = ''" onblur="this.placeholder = 'Username'" />
                            <br /><span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12 form-group">
                            <input type="text" class="form-control" asp-for="Email" placeholder="Email" onfocus="this.placeholder = ''" onblur="this.placeholder = 'Email Address'" />
                            <br /> <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                        <div class="col-md-12 form-group">
                            <input type="password" class="form-control" asp-for="Password" placeholder="Şifre" onfocus="this.placeholder = ''" onblur="this.placeholder = 'Password'" />
                            <br /><span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
           
                        @*<div class="col-md-12 form-group">
                            <div class="creat_account">
                                <input type="checkbox" id="f-option2" name="selector">
                                <label for="f-option2">Keep me logged in</label>
                            </div>
                        </div>*@
                        <div class="col-md-12 form-group">
                            <button type="submit" value="submit" class=" button-hero">Üye ol</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<!--================End Login Box Area =================-->






