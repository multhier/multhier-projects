        <p>
            Userın Cart ı var onu alıp istediği ürünleri ekleyeceğiz.<br />
            eğer cart boş değilse
            cart içerisindeki cart itemları ekleyeceğiz<br />
            kullanıcı eskiden ekledği(productId= 3) ürünü tekrar ekliyorsa<br />
            yeni bir cartItem açarak eklememeli, Quantity sini artırmalı 1 ise 2 olmalı.<br />
            bunun için cart içindekiFindIndex metodu kullanılır eğer 0 yada üzeri rakam getirirse demek daha önceden eklenmiş demektir.<br />
            yani var index deriz cart.cartitems.findindex(x.proId == proId) eğer 0 dan büyükse eklenmiş demektir.<br />
            0 dan küçükse yeni ekleyeceğiz<br />
            Update etmek istediğimizde tablo güncellenir ama ilişkili cartItem tablosunu güncellenmez<br />
            Bunun için farklı bir update metdu yazabiliriz Include cartItems deriz.<br />
            Ama bunun yerine repository deki update metodunu virtual edelim böylelikle override yapıp ezebileceğiz.<br />
        </p>


        <pre class="prettyprint">
namespace Dal.Concrete.EfCore
{
    public class CartRepository : BaseRepository&lt;Cart, AppDbContext>, ICartRepository
    {
        public CartRepository(AppDbContext context) : base(context)
        {
        }

        public void InitializeCart(string userId)
        {
            context.Add(new Cart() { UserId = userId });
        }
        public Cart GetCartByUserId(string userId)
        {
            return context.Cart.Include(x => x.CartItems).ThenInclude(x => x.Product).FirstOrDefault(i => i.UserId == userId);
        }

        public void AddToCart(string userId, int productId, int quantity)
        {
            var cart = GetCartByUserId(userId);
            if (cart != null)
            {
                var index = cart.CartItems.FindIndex(x => x.ProductId == productId);
                if (index < 0)  //yeni eklenir
                {
                    cart.CartItems.Add(new CartItem() { ProductId = productId, Quantity = quantity, CartId = cart.Id });
                }
                else  //var zaten sadece quantity artır
                {
                    cart.CartItems[index].Quantity  += quantity;
                }
                Update(cart);
            }
        }
        public override Cart Update(Cart prm)
        {
            context.Cart.Update(prm);
            context.SaveChanges();
            return prm;
        }
    }
}
