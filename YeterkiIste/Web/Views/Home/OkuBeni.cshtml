        <div id="2Detayli">
            <h6>Detaylı Bilgi</h6>
            <p>
                Şimdi  Yetki ve Remember me özelliğinide ekleyeceğiz.<br />
                Amacımız RememberMe Check kontrolü koyarak, kullanıcıyı 60 gün otomatik tanıması.<br />
                Login metodunda sıra ile yapacaklarımız;<br />
                İlk önce findEmail metodu ile user değişkenimizi bir oluşturalım.<br />
                2 User var ise diye başlayalım<br />
                3 IsLockedOutAsync ise ModelError ile kilitlendiğini belirtelim.<br />
                4 Signout ile bir temizleyelim login gibi bilgileri<br />
                5 PasswordSignInAsync ile rememberme özelliğini ele alalım.
            </p>
            <pre class="prettyprint">
public class HomeController : BaseController
{

public HomeController(IUnitofWork uow, UserManager&lt;AppUser> userManager, SignInManager&lt;AppUser> signInManager, RoleManager&lt;AppRole> roleManager) : base(uow, userManager, signInManager, roleManager)
{
}
   
[HttpPost]
[AllowAnonymous]
[ValidateAntiForgeryToken]
public async Task&lt;IActionResult> Login(LoginVM prm)  //, string returnUrl
{
    if (ModelState.IsValid)
    {
    var user = await userManager.FindByEmailAsync(prm.Email);
    if (user != null)
    {
        if (await userManager.IsLockedOutAsync(user))
        {
            ModelState.AddModelError("", "Hesabınız bir süreliğine kilitlenmiştir.Lütfen daha sonra tekrar deneyiniz.");
            return View(prm);
        }
        await signInManager.SignOutAsync();
        var result = await signInManager.PasswordSignInAsync(user, prm.Password, prm.RememberMe, false);
        if (result.Succeeded)
        {
            await userManager.ResetAccessFailedCountAsync(user);
            if (TempData["Tutucu1"] != null)
            {
                return Redirect(TempData["Tutucu1"].ToString());
            }
            else
            {
                return RedirectToAction("Index", "Home");
            }
            // ya da return Redirect(returnUrl ?? "/");
        }
        else
        {
            await userManager.AccessFailedAsync(user);
            int fail = await userManager.GetAccessFailedCountAsync(user);
            ModelState.AddModelError("", $"{fail} kez başarısız giriş.");
            if (fail==3)
            {
                await userManager.SetLockoutEndDateAsync(user, new System.DateTimeOffset(DateTime.Now.AddMinutes(5)));
                ModelState.AddModelError("", "Hesabınız 3 başarısız giriş dolayısıyla 5dk. süreyle kısıtlanmıştır.Daha sonra tekrar deneyin");
            }
            else
            {
                ModelState.AddModelError("Email", "Kullanıcı adı veya Email hesabı hatalı");
            }
        }
    }
    else
    {
        ModelState.AddModelError("Email", "Bu email adresine kayıtlı kullanıcı bulunamamıştır.");
    }
    } 
    return View(prm);
}
