[HttpPost]
[ValidateAntiForgeryToken]
public async Task&lt;IActionResult> SignUp(UserVM prm)
{

    AppUser appuser = new AppUser();
    appuser.UserName = prm.UserName;
    appuser.Email = prm.Email;
    appuser.PasswordHash = prm.Password;

    IdentityResult result = await userManager.CreateAsync(appuser, prm.Password);

    if (result.Succeeded)
    {
        uow.Cartuow.InitializeCart(appuser.Id);
        await uow.SaveChangesAsyn();
        TempData.Show("Tutucu1", new ResultMessage() { Title = "Tebrikler", Message = "Sitemize başarılı bir şekilde üye oldunuz", Css = "success" });

        return RedirectToAction("SignIn");
    }
    else
    {
        foreach (IdentityError item in result.Errors)
        {
            ModelState.AddModelError("", item.Description);
        }
    }
    return View(prm);
}
