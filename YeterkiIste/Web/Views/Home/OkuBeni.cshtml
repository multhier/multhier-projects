    <h3> <a data-toggle="collapse" href="#collapseExample3" role="button" aria-expanded="false" aria-controls="collapseExample">Dal Katmanı - Veritabanı Oluşumu <small>(Context-Fluent Api-Migration)</small></a></h3>
    <div class="collapse" id="collapseExample3">
        <p>
            Bu aşamada Proje için bir veritabanı context'i oluşacak.<br />
            Modeller belirtilecek, aralarındaki ilişki Fluent Api ile açıklanacak.<br />
            Migration aracılığıyla modeller, veritabanına eklenip aynı zamanda projede liste şeklinde bir sınıfta yer alacak.<hr />
            Veritabanı oluşumu Dal Katmanında gerçekleşecek.<br />
            Bu katman'a  işlemler için  birkaç kütüphaneler eklenmesi gerekir.Nugget Kütüphanesi çalıştırılır.<br />
            Ef Core, Ef Core Design, Ef Core Sql Server,Ef Core Tools kütüphaneleri indirilir.<br />
            Aynı zamanda Web katmanına Ef Core Design kütüphanesi eklenir.<br />
            Projede,Dal Katmanında Concrete adında bir klasör ve onun içersinde EfCore adında bir klasör oluşturulur.<br />
            Buraya ProjeAdiDbContext adında bir sınıf oluşturulur.(isteğe bağlı)<br />
            Bu sınıf DbContext'ten kalıtım alacak.<br />
            override yazıp ilgili metotlara bakıldığında ,şimdilik gerekli olan Configure ve Model_Creating metotları çağrılıp ezilir.<br />
            Configure metodunda, SqlServer Bilgisi girilir. <br />
            <span class="guncel" style="display:block"><b>Güncel not:</b> Bağlantı cümlesini (özellikle şifre içeriyorsa) koda yazmak güvenlik açığıdır;
            kod paylaşıldığında şifre de paylaşılmış olur. Bu projede artık Configure metodu kullanılmıyor: bağlantı
            appsettings.json / User Secrets / ortam değişkeninden okunup Startup.cs'te verilir (aşağıdaki "Startup dosyasında Context yolu" bölümüne bakın).</span>
            ModelCreating metodunda, modeller ve ara tablolar arasında ilişkiler belirtilir.<br />
            Sayfanın genelinde ise modeller belirtilir ve DbSet değişkeni ile veritabanındaki tablolar ile eşleştirilir.<br />
            Startup.cs dosyasında context/context yolu belli edilir.<hr />
            Projenin araçlar sekmesinden Package Manager Console aracı açılır.<br />
            Varsayılan proje olarak Dal Katmanı seçilir.<br />
            add-migration aciklama <br />
            update-database -verbose <br />
            Komutlar girilerek veritabanı oluşturulur.<br />
        </p>

        <h5>
            Not:Veritabanı yolu belirtilirken / (slash) kulanılması gerekirse  \\ (iki ters slash) koyulur.<br />
            İfade satır haline (stringleştirilmesi) dönüştürülmesi istenirse &#64; kullanılır.örn; &#64;"Server=...<br />
        </h5>


        <h4 class="badge-dark">Context</h4>

<pre class="prettyprint concrete">
public  class AppDbContext:DbContext
{
    protected override void OnConfiguring(DbContextOptionsBuilder optionsBuilder)
    {
        optionsBuilder.UseSqlServer("server=.; Database=WorldMarketCenterDB; Integrated Security=True");
        base.OnConfiguring(optionsBuilder);
    }

    public DbSet&lt;Category> Category { get; set; }
    public DbSet&lt;Product> Product { get; set; }
    public DbSet&lt;CategoryProduct> CategoryProduct { get; set; }
    public DbSet&lt;ProductAttribute> ProductAttribute { get; set; }
    public DbSet&lt;Image> Image { get; set; }
    public DbSet&lt;Order> Order { get; set; }
    public DbSet&lt;Campaign> Campaign { get; set; }
}
</pre>
        <br />
        <h4 class="badge-dark">Fluent Api</h4>
        <p>Fluent Api Delete Behaviourlar 3 çeşittir.</p>
        <ul>
            <li>Cascade: Child/dependent entity should be deleted</li>
            <li>Restrict: Dependents are unaffected</li>
            <li>SetNull: The foreign key values in dependent rows should update to NULL</li>
        </ul>
<pre class="prettyprint concrete">
public  class AppDbContext:DbContext
{
    protected override void OnModelCreating(ModelBuilder m)
    {
        m.Entity&lt;Category>().Property(x => x.Name).HasMaxLength(100);
        m.Entity&lt;Product>().Property(x => x.Name).HasMaxLength(150);
        m.Entity&lt;CategoryProduct>().HasKey(x=> new {x.CategoryId,x.ProductId });
        m.Entity&lt;ProductAttribute>().HasOne(p => p.Product).WithMany(p => p.ProductAttributes).HasForeignKey(p => p.ProductId).OnDelete(DeleteBehavior.ClientSetNull);
        m.Entity&lt;Image>().HasOne(p => p.Product).WithMany(p => p.Images).HasForeignKey(p => p.ProductId).OnDelete(DeleteBehavior.ClientSetNull);
        m.Entity&lt;Campaign>(x =>
        { 
            x.Property(e => e.Description).HasMaxLength(500);
            x.Property(e => e.Link).IsRequired().HasMaxLength(100);
            x.Property(e => e.AddedTime).HasColumnType("datetime");  
        });
             
        base.OnModelCreating(m);
    }
}
</pre>


<pre class="prettyprint">
<b>Startup.cs</b>
public void ConfigureServices(IServiceCollection services)
    {
        services.AddMvc(option => option.EnableEndpointRouting = false); 
        services.AddDbContext&lt;AppDbContext>(); 
    }
</pre>

        <p> <a data-toggle="collapse" href="#startup1" role="button" aria-expanded="false" aria-controls="collapseExample">Startup dosyasu tamamı</a></p>
        <div class="collapse" id="startup1">
<pre class="prettyprint">
<b>Startup.cs</b>
public void ConfigureServices(IServiceCollection services)
    {
        services.AddMvc(option => option.EnableEndpointRouting = false); 
        services.AddDbContext&lt;AppDbContext>(); 
    }

    public void Configure(IApplicationBuilder app, IWebHostEnvironment env)
    {
        if (env.IsDevelopment())
        {
            app.UseDeveloperExceptionPage();
        }
        using (var serviceScope = app.ApplicationServices.GetRequiredService&lt;IServiceScopeFactory>().CreateScope())
        {
            var context = serviceScope.ServiceProvider.GetService&lt;AppDbContext>();
            context.Database.Migrate(); 
        }
         
        app.UseStaticFiles();
        app.UseCookiePolicy();
        app.UseMvc(x =>
        {
            x.MapRoute("areas", "{area:exists}/{controller}/{action}/{id?}", new { controller = "Home", Action = "Index" });
            x.MapRoute( name: "products",template: "products/{category?}", defaults: new { controller = "Products", action = "Index" });
            x.MapRoute("default", "{controller}/{action}/{id?}", new { controller = "Home", Action = "Index" });
        });

    }
} 
