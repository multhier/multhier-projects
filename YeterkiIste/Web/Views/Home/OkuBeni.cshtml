        switch (sortBy.Value)
        {
            case 2:
                data = data.OrderByDescending(x => x.Id).ToList(); //yeni çıkanlar

                break;
            case 3:
                data = data.OrderBy(x => x.Price).ToList(); //ucuzdan pahalıya
                break;
            case 4:
                data = data.OrderByDescending(x => x.Price).ToList(); //pahalıdan ucuza
                break;
            default:
                data = data.OrderBy(x => x.Id).ToList(); //defaul
                break;
        }
    }
    if (minPrice.HasValue)
    {
        data = data.Where(x => x.Price >= Convert.ToDecimal(minPrice.Value)).ToList();
    }

    if (maxPrice.HasValue)
    {
        data = data.Where(x => x.Price <= maxPrice.Value).ToList();
    }

    var pager = new Pager(data.Count(), prm_page);  //total item 26 oldu  total items 26 oldu

    data = data
    .Skip(pager.PageSize * (prm_page - 1).Value)
    .Take(pager.PageSize)
    .ToList();  //data 9 ürün geldi

    return View(new MyProductVM { Products = data, Pager = pager, CategoryRoute = category , sortBy=sortBy, Brands=branddata, BrandRoute = prm_brand , search=search, minPrice=minPrice, maxPrice=maxPrice });  
}
