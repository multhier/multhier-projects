public IActionResult Index(int? prm_colorId)
{
    MyProductVM myProductVM = new MyProductVM();
    myProductVM.ColorId = prm_colorId;

    myProductVM.Products = ProductListWithParameters(prm_colorId).ToList();

    return View(myProductVM);
}

public List&lt;Product> ProductListWithParameters(int? prm_colorId)
{
    var data = uow.Productuow.GetAllWithQuery().Include(x => x.Color).ToList();

    if (prm_colorId.HasValue)
    {
        data = data.Where(x => x.ColorId == prm_colorId.Value).ToList();
    }

    return data.ToList();
}
