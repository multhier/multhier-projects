public IActionResult Index(string category, int? prm_page, int? prm_brand, int? sortBy)
{
    prm_page = prm_page.HasValue ? prm_page.Value > 0 ? prm_page.Value : 1 : 1; //page 1 oldu

    var branddata = uow.Branduow.GetAll().ToList();
    var data = uow.Productuow.GetAllWithQuery()
        .Include(x => x.CategoryProducts)
        .ThenInclude(y => y.Category).ToList();


    if (!string.IsNullOrEmpty(category))
    {
        data = data.Where(x => x.CategoryProducts.Any(a => Web.Models.Infrastructure.F_Tool.URLDuzelt(a.Category.Name) == category)).ToList();
    }

    if (prm_brand.HasValue)
    {
        data = data.Where(x => x.BrandId == prm_brand.Value).ToList();
    }

    if (sortBy.HasValue)
    {
        switch (sortBy.Value)
        {
            case 2:
                data = data.OrderByDescending(x => x.Id).ToList(); //yeni çıkanlar

                break;
            case 3:
                data = data.OrderBy(x => x.Price).ToList(); //ucuzdan pahalıya
                break;
            case 4:
                data = data.OrderByDescending(x => x.Price).ToList(); //pahalıdan ucuza
                break;
            default:
                data = data.OrderBy(x => x.Id).ToList(); //defaul
                break;
        }
    }


    var pager = new Pager(data.Count(), prm_page);  //total item 26 oldu  total items 26 oldu

    data = data
        //.OrderBy(x => x.Id) artık gerek kalmaz
    .Skip(pager.PageSize * (prm_page - 1).Value)
    .Take(pager.PageSize)
    .ToList();  //data 9 ürün geldi

    return View(new MyProductVM { Products = data, Pager = pager, CategoryRoute = category , sortBy=sortBy, Brands=branddata, BrandRoute = prm_brand  });  
}
