        <p>
            Kendi kuralarımızı vermek için bir klasör oluşturalım. Adı Infastructure olsun, sınıfın adı ise CustomPasswordValidator olsun.
            <br /> CustomPasswordValidator  oluşturduktan sonra   IPasswordValidator dan kalıtım alırız.<br />
            IPasswordValidator generic olduğu için dışardan user modeli vereceğiz.<br />
            Interfaceden türettiğimiz için VisualStudioda çift tıkaltıp arabirimini uygulayalım.<br />
            ValidateAsync metodu gelecektir.İçerisini dolduralım.<br />
            public class CustomPasswordValidator : IPasswordValidator&lt;AppUser>
        </p>

        <pre class="prettyprint">
using Microsoft.AspNetCore.Identity;
using Model;
using System.Collections.Generic;
using System.Threading.Tasks;

public class CustomPasswordValidator : IPasswordValidator&lt;AppUser>
{
    public Task&lt;IdentityResult> ValidateAsync(UserManager&lt;AppUser> manager, AppUser user, string password)
    {
        List&lt;IdentityError> errors = new List&lt;IdentityError>();
        if (password.ToLower().Contains(user.UserName.ToLower()))
        {
            errors.Add(new IdentityError() { Code = "Password couldnt match with UserName", Description = "Şifre alanı kullanıcı adı içeremez" });
        }
        if (password.ToLower().Contains("1234"))
        {
                errors.Add(new IdentityError() { Code = "PasswordContains1234", Description = "Şifre alanı ardışık sayı içeremez." });
        }
        if (password.ToLower().Contains(user.Email.ToLower()))
        {
            errors.Add(new IdentityError() { Code = "PasswordContainsinlinesequence",  Description = "Şifre alanı email adresinizi içeremez" });
        }
   
        if (errors.Count==0)
        {
            return Task.FromResult(IdentityResult.Success);
        }
        else
        {
            return Task.FromResult(IdentityResult.Failed(errors.ToArray()));
        }
//Ternary if ile eklersek;    return Task.FromResult(errors.Count == 0 ? IdentityResult.Success : IdentityResult.Failed(errors.ToArray()));
    }
}

