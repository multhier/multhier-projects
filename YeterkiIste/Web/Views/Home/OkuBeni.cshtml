<pre class="prettyprint">
[HttpPost]
public ActionResult Index(int? BrandId, int? ColorId)
{
    var data = uow.Productuow.GetAllWithQuery().Include(x => x.Brand).Include(x => x.Color).ToList();

    if (BrandId.HasValue)
    {
        data = data.Where(x => x.BrandId == BrandId).ToList();
    }
    if (ColorId.HasValue)
    {
        data = data.Where(x => x.ColorId == ColorId).ToList();
    }
    return View( new MyProductVM() { Products = data, ColorId = ColorId, BrandId = BrandId });

    //return RedirectToAction("Index", "Products", new MyProductVM() {  BrandId = BrandId, ColorId = ColorId});
}
