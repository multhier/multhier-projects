@model IEnumerable<Product>



    <section class="section-margin1 text-center mt-5 ">
        <div class="container">
            <div class="section-intro  pb-lg-4">
                <p>En iyi Satış yakalamış ürünler </p>
                <h2>Öne  Çıkan <span class="section-intro__style"> Ürünler</span></h2>
            </div>
            <div class="owl-carousel owl-theme" id="bestSellerCarousel">



                @foreach (var item in Model)
                {
                <div class="card text-center card-product">
                    <div class="card-product__img">
                        <img class="img-fluid" src="@item.ImageUrl" alt="">
                        <ul class="card-product__imgOverlay">
                            <li>
                                <a asp-route-detailname="@Url.FriendlyUrl(item.Name.ToString())"
                                   asp-route-Id="@item.Id" class="text-white" 
                                   asp-controller="Ogeler" asp-action="detail"><i class="ti-search"></i></a>
                            </li>
                            <li>
                                @if (User.Identity.IsAuthenticated)
                                {
                                    <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="text-white" ><i class="ti-shopping-cart"></i></button>
                                    </form>
                                }
                            </li>
                        </ul>
                    </div>
                    <div class="card-body">
                        @foreach (var item2 in item.CategoryProducts.Where(x => x.Category.ParentId != null))
                        {
                            <a asp-controller="ogeler" asp-action="Index" asp-route-category="@Url.FriendlyUrl(item2.Category.Name)">  @item2.Category.Name</a>
                        }
                        <h4 class="card-product__title">
                            <a asp-route-detailname="@Url.FriendlyUrl(item.Name.ToString())"
                               asp-route-Id="@item.Id" class="btn btn-sm "
                               asp-controller="Ogeler" asp-action="detail">@item.Name</a>
                        </h4>
                        <p class="card-product__price">@item.Price.ToString("c")</p>

                    </div>
                </div>
                }

            </div>
        </div>
    </section>


