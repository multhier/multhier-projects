@model Web.ViewModels.PasswordChangeVM



 




<div class="product_image_area " style="background: #fdfdfd">
    <div class="container">
        
@if (TempData["TutucuBasari"] != null)
{

    <div class="alert alert-info">@TempData["TutucuBasari"]</div>
}
      <div class="row s_product_inner">


        <div class="col-6 col-lg-4">
            @Html.Partial("Partials/UserProfileList")
            <br /><div class="clearfix"></div>
        </div>


        <div class="col-12 col-lg-8">

            <div class="animsition">
                <div class="col-9 col-lg-6 float-left   mb-2" style="padding:25px 15px;">
                    <form asp-action="ChangePassword">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-group">
                            <label asp-for="PasswordOld" class="control-label"></label>
                            <input asp-for="PasswordOld" class="form-control" />
                            <span asp-validation-for="PasswordOld" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="PasswordNew" class="control-label"></label>
                            <input asp-for="PasswordNew" class="form-control" />
                            <span asp-validation-for="PasswordNew" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="PasswordConfirm" class="control-label"></label>
                            <input asp-for="PasswordConfirm" class="form-control" />
                            <span asp-validation-for="PasswordConfirm" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <input type="submit" value="Kaydet" class="button-hero" />
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>



</div>



